<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="page-pad" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SubjectsController">

    <Label styleClass="page-title" text="My Subjects" />
    <Label styleClass="page-subtitle" text="The subjects you are enrolled in, with your grade level and section." />

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="subjectsTable" minHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn minWidth="75.0" prefWidth="100.0" text="Code">
                    <cellValueFactory><PropertyValueFactory property="subjectCode" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="165.0" prefWidth="220.0" text="Subject">
                    <cellValueFactory><PropertyValueFactory property="subjectName" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="97.0" prefWidth="130.0" text="Grade &amp; Section">
                    <cellValueFactory><PropertyValueFactory property="section" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="82.0" prefWidth="110.0" text="School Year">
                    <cellValueFactory><PropertyValueFactory property="schoolYear" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="75.0" prefWidth="100.0" text="Grade Level">
                    <cellValueFactory><PropertyValueFactory property="gradeLevel" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
</VBox>
