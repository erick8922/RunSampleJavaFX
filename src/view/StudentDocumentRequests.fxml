<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DocumentRequestsController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label styleClass="page-title" text="Document Requests" />
    <Label styleClass="page-subtitle" text="Request school documents and track the status of your requests." />

    <!-- New request -->
    <VBox spacing="10.0" styleClass="card">
        <Label styleClass="section-title" text="New Request" />

        <Label styleClass="field-label" text="DOCUMENT TYPE" />
        <ComboBox fx:id="documentTypeCombo" maxWidth="Infinity" promptText="Select a document">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Certificate of Enrollment" />
                    <String fx:value="Transcript of Records" />
                    <String fx:value="Good Moral" />
                    <String fx:value="Diploma Copy" />
                    <String fx:value="Certificate of Grades" />
                </FXCollections>
            </items>
        </ComboBox>

        <Label styleClass="field-label" text="PURPOSE" />
        <TextArea fx:id="purposeArea" prefRowCount="3" promptText="Why do you need this document? (e.g. scholarship application, transfer to another school)" wrapText="true" />

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <Button fx:id="submitButton" onAction="#handleSubmit" styleClass="btn-primary" text="Submit Request" />
            <Label fx:id="messageLabel" />
        </HBox>
    </VBox>

    <!-- History -->
    <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
        <Label styleClass="section-title" text="My Requests" />
        <TableView fx:id="requestsTable" minHeight="180.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="200.0" text="Document">
                    <cellValueFactory><PropertyValueFactory property="documentType" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="240.0" text="Purpose">
                    <cellValueFactory><PropertyValueFactory property="purpose" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status">
                    <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="170.0" text="Requested On">
                    <cellValueFactory><PropertyValueFactory property="requestedAt" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
</VBox>
