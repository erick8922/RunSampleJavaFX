<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="560.0" prefWidth="880.0" stylesheets="@app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <!-- Left: branding -->
    <VBox alignment="CENTER" prefWidth="380.0" spacing="14.0" styleClass="brand-panel">
        <Label style="-fx-font-size: 64px; -fx-font-family: 'Segoe UI Emoji';" text="🎓" />
        <Label maxWidth="300.0" styleClass="brand-school" text="Manuel B. Guiñez Sr. National High School" textAlignment="CENTER" wrapText="true" />
        <Label styleClass="brand-subtitle" text="Student Information System" />
    </VBox>

    <!-- Right: sign in form -->
    <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="6.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40.0" left="70.0" right="70.0" top="40.0" />
        </padding>

        <Label styleClass="page-title" text="Welcome" />
        <Label styleClass="page-subtitle" text="Sign in to your account to continue." />
        <Region prefHeight="18.0" />

        <Label styleClass="field-label" text="USERNAME" />
        <TextField fx:id="usernameField" promptText="Enter your username" />
        <Region prefHeight="8.0" />

        <Label styleClass="field-label" text="PASSWORD" />
        <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Enter your password" />
        <Region prefHeight="14.0" />

        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="42.0" styleClass="btn-primary" text="Sign In" />

        <HBox alignment="CENTER" spacing="2.0">
            <Label styleClass="page-subtitle" text="Don't have an account yet?" />
            <Hyperlink onAction="#handleRegister" text="Register here" />
        </HBox>
    </VBox>

</HBox>
