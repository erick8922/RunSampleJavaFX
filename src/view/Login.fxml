<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="rootBox" minHeight="480.0" minWidth="300.0" prefHeight="600.0" prefWidth="940.0" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <!-- Wide window: school panel on the left -->
    <VBox fx:id="brandPanel" alignment="CENTER" minWidth="320.0" prefWidth="400.0" spacing="14.0" styleClass="brand-panel">
        <Label style="-fx-font-size: 72px; -fx-font-family: 'Segoe UI Emoji';" text="🎓" />
        <Label maxWidth="320.0" styleClass="brand-school" text="Manuel B. Guiñez Sr. National High School" textAlignment="CENTER" wrapText="true" />
        <Label styleClass="brand-subtitle" text="Student Portal" />
    </VBox>

    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" HBox.hgrow="ALWAYS">
        <VBox styleClass="login-form">

            <!-- Small window (phone size): school panel moves to the top -->
            <VBox fx:id="topBrand" alignment="CENTER" managed="false" spacing="6.0" styleClass="brand-top" visible="false">
                <Label style="-fx-font-size: 40px; -fx-font-family: 'Segoe UI Emoji';" text="🎓" />
                <Label maxWidth="Infinity" styleClass="brand-school" text="Manuel B. Guiñez Sr. National High School" textAlignment="CENTER" wrapText="true" />
                <Label styleClass="brand-subtitle" text="Student Portal" />
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="form-pad" VBox.vgrow="ALWAYS">
                <Label styleClass="page-title" text="Welcome!" />
                <Label styleClass="page-subtitle" text="Please sign in to see your school records." wrapText="true" />
                <Region prefHeight="16.0" />

                <Label styleClass="field-label" text="Username" />
                <TextField fx:id="usernameField" promptText="Type your username here" />
                <Region prefHeight="6.0" />

                <Label styleClass="field-label" text="Password" />
                <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Type your password here" />
                <Region prefHeight="14.0" />

                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="50.0" styleClass="btn-primary" text="Sign In" />
                <Region prefHeight="10.0" />

                <FlowPane alignment="CENTER" hgap="4.0" vgap="2.0">
                    <Label styleClass="page-subtitle" text="No account yet?" />
                    <Hyperlink onAction="#handleRegister" text="Create an account" />
                </FlowPane>
            </VBox>
        </VBox>
    </ScrollPane>

</HBox>
