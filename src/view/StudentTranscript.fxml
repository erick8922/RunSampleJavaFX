<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="page-pad" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TranscriptController">

    <Label styleClass="page-title" text="Permanent Record (Form 137)" />
    <Label styleClass="page-subtitle" text="Copies of your Form 137 (permanent record) issued by the school." />

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="transcriptTable" minHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn minWidth="97.0" prefWidth="130.0" text="School Year">
                    <cellValueFactory><PropertyValueFactory property="schoolYear" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="105.0" prefWidth="140.0" text="Issue Date">
                    <cellValueFactory><PropertyValueFactory property="issueDate" /></cellValueFactory>
                </TableColumn>
                <TableColumn minWidth="195.0" prefWidth="260.0" text="Remarks">
                    <cellValueFactory><PropertyValueFactory property="remarks" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="statusColumn" minWidth="82.0" prefWidth="110.0" text="Status">
                    <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
</VBox>
