<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            minHeight="480.0"
            minWidth="320.0"
            prefHeight="680.0"
            prefWidth="1100.0"
            styleClass="page"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.StudentDashboardController">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label fx:id="appTitleLabel" styleClass="app-title" text="Student Portal" />
                <Label fx:id="appSubtitleLabel" styleClass="app-subtitle" text="Manuel B. Guiñez Sr. National High School" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" styleClass="user-chip">
                <Label fx:id="userLabel" maxWidth="240.0" styleClass="user-chip-text" text="Student" wrapText="true" />
            </HBox>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" spacing="8.0" styleClass="sidebar">

            <fx:define>
                <ToggleGroup fx:id="navGroup" />
            </fx:define>

            <Label fx:id="menuCaption" styleClass="sidebar-caption" text="MENU" />

            <ToggleButton fx:id="homeButton"
                          maxWidth="Infinity"
                          onAction="#showHome"
                          selected="true"
                          styleClass="nav-button"
                          text="🏠  Home"
                          toggleGroup="$navGroup" />

            <ToggleButton fx:id="profileButton"
                          maxWidth="Infinity"
                          onAction="#showProfile"
                          styleClass="nav-button"
                          text="👤  My Profile"
                          toggleGroup="$navGroup" />

            <ToggleButton fx:id="gradesButton"
                          maxWidth="Infinity"
                          onAction="#showGrades"
                          styleClass="nav-button"
                          text="📊  Report Cards"
                          toggleGroup="$navGroup" />

            <ToggleButton fx:id="credentialsButton"
                          maxWidth="Infinity"
                          onAction="#showCredentials"
                          styleClass="nav-button"
                          text="🎓  Credentials"
                          toggleGroup="$navGroup" />

            <ToggleButton fx:id="requestsButton"
                          maxWidth="Infinity"
                          onAction="#showDocumentRequests"
                          styleClass="nav-button"
                          text="📄  Document Request"
                          toggleGroup="$navGroup" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutButton"
                    maxWidth="Infinity"
                    onAction="#handleLogout"
                    styleClass="nav-logout"
                    text="🚪  Log Out" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToHeight="true"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="content-scroll">

            <StackPane fx:id="contentArea" alignment="TOP_LEFT" />
        </ScrollPane>
    </center>

</BorderPane>
