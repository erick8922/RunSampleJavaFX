<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="page-pad" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController">

    <Label styleClass="page-title" text="My Profile" />
    <Label styleClass="page-subtitle" text="This is your information in our school records." wrapText="true" />

    <!-- Summary card -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="card">
        <Label fx:id="avatarLabel" alignment="CENTER" styleClass="avatar" text="?" />
        <VBox spacing="6.0">
            <Label fx:id="nameLabel" styleClass="profile-name" wrapText="true" />
            <Label fx:id="studentNoLabel" styleClass="page-subtitle" />
            <HBox>
                <Label fx:id="statusBadge" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Personal information (read only). Fields wrap to the next line on small windows. -->
    <VBox spacing="16.0" styleClass="card">
        <Label styleClass="section-title" text="Personal Information" />
        <Label styleClass="help-text" text="You cannot change these here. Please ask the registrar if something is wrong." wrapText="true" />
        <FlowPane hgap="40.0" vgap="20.0">
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="Gender" />
                <Label fx:id="genderValue" styleClass="field-value" wrapText="true" />
            </VBox>
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="Birth date" />
                <Label fx:id="birthDateValue" styleClass="field-value" wrapText="true" />
            </VBox>
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="Email" />
                <Label fx:id="emailValue" styleClass="field-value" wrapText="true" />
            </VBox>
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="Username" />
                <Label fx:id="usernameValue" styleClass="field-value" wrapText="true" />
            </VBox>
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="Grade and section" />
                <Label fx:id="gradeSectionValue" styleClass="field-value" wrapText="true" />
            </VBox>
            <VBox minWidth="230.0" prefWidth="260.0" spacing="3.0">
                <Label styleClass="field-label" text="School year" />
                <Label fx:id="schoolYearValue" styleClass="field-value" wrapText="true" />
            </VBox>
        </FlowPane>
    </VBox>

    <!-- Contact information (editable) -->
    <VBox spacing="10.0" styleClass="card">
        <Label styleClass="section-title" text="Contact Information" />
        <Label styleClass="help-text" text="You can change your contact number and address here. Then press Save Changes." wrapText="true" />

        <Label styleClass="field-label" text="Contact number" />
        <TextField fx:id="contactNoField" promptText="Example: 09123456789" />

        <Label styleClass="field-label" text="Home address" />
        <TextField fx:id="addressField" promptText="Purok/Street, Barangay, City/Municipality, Province" />

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <Button fx:id="saveButton" onAction="#handleSave" styleClass="btn-primary" text="Save Changes" />
            <Label fx:id="messageLabel" wrapText="true" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

</VBox>
