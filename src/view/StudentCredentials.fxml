<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CredentialsController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label styleClass="page-title" text="Credentials" />
    <Label styleClass="page-subtitle" text="Certificates and other credentials issued to you." />

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="credentialsTable" minHeight="220.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="260.0" text="Credential">
                    <cellValueFactory><PropertyValueFactory property="credentialType" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="150.0" text="Issue Date">
                    <cellValueFactory><PropertyValueFactory property="issueDate" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status">
                    <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
</VBox>
