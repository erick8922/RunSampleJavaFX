<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="page-pad" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CredentialsController">

    <Label styleClass="page-title" text="Credentials" />
    <Label styleClass="page-subtitle" text="These are the certificates and other papers the school has given you." wrapText="true" />

    <HBox styleClass="info-box">
        <Label styleClass="report-note" text="✔ means the credential is still valid." wrapText="true" />
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="credentialsTable" minHeight="240.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="credentialColumn" minWidth="195.0" prefWidth="260.0" text="Credential">
                    <cellValueFactory><PropertyValueFactory property="credentialType" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="dateColumn" minWidth="112.0" prefWidth="150.0" text="Date given">
                    <cellValueFactory><PropertyValueFactory property="issueDate" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="statusColumn" minWidth="90.0" prefWidth="120.0" text="Valid?">
                    <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
</VBox>
